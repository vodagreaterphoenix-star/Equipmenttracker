{
  "version": 8,
  "name": "Voda GTA Dark",
  "metadata": {
    "voda:notes": "Navy night map: every road is lit blue so the street grid reads as a glowing network, with freeways brightest. Edit any colour in voda:palette below and commit \u2014 no build step.",
    "voda:palette": {
      "land": "#0B1B2E navy ground",
      "landuse": "#0E2036 city blocks, a touch lifted",
      "water": "#071528 near-black water",
      "park": "#0C2231",
      "building": "#12283F",
      "road-minor": "#2E6FA8 lit side streets \u2014 visible from zoomed out",
      "road-secondary": "#3A88C4",
      "road-primary": "#4A9FDB",
      "road-motorway": "#5FB8F0 brightest, with a dark casing for the glow",
      "label": "#CDE4F7 near-white blue text"
    }
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#0B1B2E"
      }
    },
    {
      "id": "landuse-residential",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": [
        "==",
        "class",
        "residential"
      ],
      "paint": {
        "fill-color": "#0E2036"
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "fill-color": "#0C2231",
        "fill-opacity": 0.9
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": [
        "!=",
        "brunnel",
        "tunnel"
      ],
      "paint": {
        "fill-color": "#071528"
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#1B4B72",
        "line-width": 1.2
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-color": "#12283F",
        "fill-outline-color": "#1B3A55",
        "fill-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          13,
          0,
          15,
          0.85
        ]
      }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "in",
        "class",
        "minor",
        "service",
        "track"
      ],
      "minzoom": 10,
      "paint": {
        "line-color": "#2E6FA8",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.5
          ],
          [
            "zoom"
          ],
          10,
          0.35,
          13,
          0.8,
          16,
          2.2,
          20,
          9
        ]
      }
    },
    {
      "id": "road-secondary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "in",
        "class",
        "secondary",
        "tertiary"
      ],
      "paint": {
        "line-color": "#3A88C4",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.5
          ],
          [
            "zoom"
          ],
          8,
          0.5,
          13,
          1.6,
          18,
          8
        ]
      }
    },
    {
      "id": "road-primary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "in",
        "class",
        "primary",
        "trunk"
      ],
      "paint": {
        "line-color": "#4A9FDB",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.5
          ],
          [
            "zoom"
          ],
          7,
          0.8,
          13,
          2.4,
          18,
          11
        ]
      }
    },
    {
      "id": "road-motorway-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "==",
        "class",
        "motorway"
      ],
      "paint": {
        "line-color": "#071528",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.5
          ],
          [
            "zoom"
          ],
          5,
          2.2,
          13,
          6.5,
          18,
          20
        ]
      }
    },
    {
      "id": "road-motorway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "==",
        "class",
        "motorway"
      ],
      "paint": {
        "line-color": "#5FB8F0",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.5
          ],
          [
            "zoom"
          ],
          5,
          1.1,
          13,
          3.4,
          18,
          14
        ]
      }
    },
    {
      "id": "rail",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "==",
        "class",
        "rail"
      ],
      "minzoom": 12,
      "paint": {
        "line-color": "#1C3B5A",
        "line-width": 1,
        "line-dasharray": [
          3,
          3
        ]
      }
    },
    {
      "id": "road-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 14,
      "layout": {
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 11,
        "symbol-placement": "line"
      },
      "paint": {
        "text-color": "#9FC6E8",
        "text-halo-color": "#0B1B2E",
        "text-halo-width": 1.6
      }
    },
    {
      "id": "place-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": [
        "in",
        "class",
        "city",
        "town",
        "village",
        "suburb"
      ],
      "layout": {
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "Noto Sans Bold"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          6,
          11,
          12,
          16
        ],
        "text-transform": "none",
        "text-letter-spacing": 0.02
      },
      "paint": {
        "text-color": "#CDE4F7",
        "text-halo-color": "#0B1B2E",
        "text-halo-width": 1.6
      }
    }
  ]
}
